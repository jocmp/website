---
interface MediaReference {
	_ref: string;
	url: string;
}

export interface Props {
	node: {
		_type: "video";
		_key: string;
		asset: MediaReference;
		poster?: MediaReference;
	};
}

const { node } = Astro.props;
---

<video
	class="post-video"
	src={node.asset.url}
	poster={node.poster?.url}
	controls
	playsinline
	preload="metadata"
/>


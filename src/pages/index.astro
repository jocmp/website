---
import { getEmDashEntry, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const HOME_SLUG = "home";
const PHOTO_WIDTH = 180;

const [{ entry: home, cacheHint }, settings] = await Promise.all([
	getEmDashEntry("pages", HOME_SLUG),
	getSiteSettings(),
]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

const photo = home?.data.featured_image;
let photoHeight: number | undefined;
if (photo?.width && photo.height) {
	photoHeight = Math.round((PHOTO_WIDTH * photo.height) / photo.width);
}
---

<Base
	title={siteTitle}
	description={siteTagline}
	canonical={new URL("/", Astro.url.origin).href}
	content={home ? { collection: "pages", id: home.data.id, slug: HOME_SLUG } : undefined}
>
	<article class="h-entry">
		<section class="e-content">
			{
				home && (
					<div class="about">
						<div class="about-text">
							<PortableText value={home.data.content} />
						</div>
						{photo && (
							<div class="about-photo">
								<Image image={photo} width={PHOTO_WIDTH} height={photoHeight} />
							</div>
						)}
					</div>
				)
			}
		</section>
	</article>
</Base>

---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../../layouts/Base.astro";
import { postPermalink } from "../../utils/permalink";
import { formatIsoDate } from "../../utils/dates";

const [{ entries: posts, cacheHint }, termsResult] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 1000,
	}),
	getTaxonomyTermsWithCacheHint("tag", { includeCounts: false }),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsResult.cacheHint);
}

const archiveEntries = posts.flatMap((post) => {
	const publishedAt = post.data.publishedAt;
	if (!publishedAt) {
		return [];
	}
	return [
		{
			title: post.data.title,
			url: postPermalink(post.id, publishedAt),
			date: formatIsoDate(publishedAt),
		},
	];
});
---

<Base title="Archive" description="All posts">
	<h1 class="page-title">Archive</h1>
	<div id="container" class="h-feed">
		<section id="main" class="outer">
			<div class="archive_categories">
				{
					termsResult.data.map((term) => (
						<p>
							<a href={`/categories/${term.slug}/`}>{term.label}</a>
						</p>
					))
				}
			</div>
			<hr />
			<br /><br />
			{
				archiveEntries.map((entry) => (
					<p class="h-entry" style="padding-bottom: 5px;">
						<a href={entry.url} class="u-url">
							<span class="dt-published">{entry.date}</span>
						</a>{" "}
						<span class="p-name">
							<b>{entry.title}</b>
						</span>
					</p>
				))
			}
		</section>
	</div>
</Base>

---
import { getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import { postPermalink } from "../../utils/permalink";
import { formatShortDate } from "../../utils/dates";
import { summarize } from "../../utils/text";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = termsResult.data.find((item) => item.slug === slug);

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 10,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

const entries = posts.flatMap((post) => {
	const publishedAt = post.data.publishedAt;
	if (!publishedAt) {
		return [];
	}
	return [
		{
			title: post.data.title,
			url: postPermalink(post.id, publishedAt),
			summary: post.data.excerpt || summarize(post.data.content),
			isoDate: publishedAt.toISOString(),
			date: formatShortDate(publishedAt),
		},
	];
});

const termUrl = `/categories/${term.slug}/`;
---

<Base title={term.label} description={`Posts in ${term.label}`}>
	<div id="container">
		<section id="main" class="outer">
			<section class="archives-wrap">
				<div class="archive-tag-wrap">
					<span class="archive-tag">#{term.label.toLowerCase()}</span>
				</div>
				<div class="archives">
					{
						entries.map((entry) => (
							<>
								<article class="h-entry">
									<h1>
										<a class="archive-article-title u-url" href={entry.url}>
											{entry.title}
										</a>
									</h1>
									{entry.summary && (
										<div class="p-summary">
											<section>
												<p>{entry.summary}</p>
												<p>
													<a href={entry.url}>Continue reading →</a>
												</p>
											</section>
										</div>
									)}
									<a href={entry.url} class="archive-article-date u-url">
										<time datetime={entry.isoDate} itemprop="datePublished">
											{entry.date}
										</time>
									</a>
								</article>
								<hr />
							</>
						))
					}
				</div>
			</section>
			<nav id="page-nav">
				{
					cursor && (
						<span class="prev">
							<a href={termUrl}>
								<span class="arrow">←</span> Newer Posts
							</a>
						</span>
					)
				}
				{
					nextCursor && (
						<span class="next">
							<a href={`${termUrl}?cursor=${encodeURIComponent(nextCursor)}`}>
								Older Posts <span class="arrow">→</span>
							</a>
						</span>
					)
				}
			</nav>
		</section>
	</div>
</Base>

---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../../../layouts/Base.astro";
import Video from "../../../../components/Video.astro";
import { resolveBlogSiteIdentity } from "../../../../utils/site-identity";
import { postPermalink } from "../../../../utils/permalink";
import { formatLongDate } from "../../../../utils/dates";
import { summarize } from "../../../../utils/text";
import { author } from "../../../../utils/author";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

const permalink = postPermalink(post.id, post.data.publishedAt);
if (post.data.publishedAt && Astro.url.pathname.replace(/\/?$/, "/") !== permalink) {
	return Astro.redirect(permalink, 301);
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: permalink,
	titleSeparator: " // ",
});

const description = seo.description || post.data.excerpt || summarize(post.data.content, 30);
const tags = post.data.terms?.tag ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	author={author.name}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="post h-entry">
		<header class="post-header">
			<div class="post-date-wrapper">
				{
					post.data.publishedAt && (
						<time class="dt-published" datetime={post.data.publishedAt.toISOString()}>
							{formatLongDate(post.data.publishedAt)}
						</time>
					)
				}
			</div>
			<h1 class="p-name post-title" {...post.edit.title}>{post.data.title}</h1>
		</header>

		<article class="post-content e-content with-title">
			<PortableText value={post.data.content} components={{ type: { video: Video } }} />
		</article>
	</div>

	{
		tags.length > 0 && (
			<div class="content-meta">
				<ul class="post-tags">
					{tags.map((tag) => (
						<li>
							<a href={`/categories/${tag.slug}/`}>{tag.label}</a>
						</li>
					))}
				</ul>
			</div>
		)
	}
</Base>

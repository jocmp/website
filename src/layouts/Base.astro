---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { author as siteAuthor, authorJsonLd } from "../utils/author";
import "../styles/style.css";
import "../styles/custom.css";
import "../styles/emdash.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settingsResult.data);
const menu = menuResult.data;

const titleSuffix = ` // ${siteTitle}`;
let fullTitle = `${title}${titleSuffix}`;
if (title === siteTitle || title.endsWith(titleSuffix)) {
	fullTitle = title;
}

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image: image ?? new URL(siteAuthor.avatarPath, Astro.url.origin).href,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const personJsonLd = JSON.stringify(authorJsonLd(Astro.url.origin));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="alternate" type="application/rss+xml" title={siteTitle} href="/feed.xml" />
		{siteAuthor.profiles.map((href) => <link rel="me" href={href} />)}
		<meta name="fediverse:creator" content={siteAuthor.fediverseHandle} />
		<EmDashHead page={pageCtx} />
		<script type="application/ld+json" set:html={personJsonLd} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<div class="container">
			<header id="header">
				<div id="header-outer" class="outer">
					<div id="header-inner" class="inner">
						<a id="logo" class="logo-text" href="/">{siteTitle}</a>
						{siteTagline && <p class="subtitle">{siteTagline}</p>}
						<nav id="main-nav">
							{
								menu?.items.map((item) => (
									<a class="main-nav-link" href={item.url} target={item.target}>
										{item.label}
									</a>
								))
							}
							<a class="main-nav-link" href="/feed.xml">RSS</a>
						</nav>
					</div>
				</div>
			</header>
			<slot />
			<footer id="footer">
				<div class="outer">
					<div id="footer-info" class="inner">
						&copy; {new Date().getFullYear()} {siteAuthor.name}
					</div>
				</div>
			</footer>
		</div>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

#!/usr/bin/env ruby

# Convert all mp4s in static/uploads to webm (VP9) alongside the originals

root = File.expand_path("..", __dir__)
mp4s = Dir.glob(File.join(root, "static/uploads/**/*.mp4"))

mp4s.each do |mp4|
  webm = mp4.sub(/\.mp4$/, ".webm")
  if File.exist?(webm)
    puts "skip: #{webm}"
    next
  end
  puts "converting: #{mp4}"
  system("ffmpeg", "-i", mp4, "-c:v", "libvpx-vp9", "-crf", "30", "-b:v", "0",
         "-c:a", "libopus", "-an", webm, exception: true)
end

puts "done"

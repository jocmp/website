#!/usr/bin/env ruby

# Cross-checks /uploads/ references in content against static/uploads/

root = File.expand_path("..", __dir__)
static = File.join(root, "static")

# Collect all /uploads/ references from content
refs = {}
Dir.glob(File.join(root, "content", "**", "*.md")).each do |file|
  File.read(file).scan(%r{/uploads/[^\s)"'>]+}).each do |path|
    (refs[path] ||= []) << file.sub("#{root}/", "")
  end
end

# Check for broken references
broken = refs.reject { |path, _| File.exist?(File.join(static, path)) }
if broken.any?
  puts "Broken references:"
  broken.each do |path, files|
    files.each { |f| puts "  #{f} -> #{path}" }
  end
else
  puts "All references OK"
end

# Check for orphaned uploads
all_files = Dir.glob(File.join(static, "uploads", "**", "*"))
  .select { |f| File.file?(f) }
  .map { |f| f.sub(static, "") }
orphaned = all_files - refs.keys
if orphaned.any?
  puts "\nOrphaned uploads (#{orphaned.size}):"
  orphaned.each { |f| puts "  static#{f}" }
end
